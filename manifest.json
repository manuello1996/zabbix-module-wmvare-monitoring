{
	"manifest_version": 2.0,
	"author": "Manuel Pesenti",
	"id": "vmware_monitoring",
	"type": "module",
	"name": "VMware Monitoring",
	"namespace": "VMwareMonitoring",
	"version": "1.3.0",
	"description": "vCenter, hypervisor, virtual machine, datastore, optional distributed switch and issue overview for Zabbix VMware monitoring.",
	"actions": {
		"vmware.monitoring.dvswitch": {
			"class": "CControllerVMwareDvswitch",
			"view": "vmware.monitoring.dvswitch",
			"layout": "layout.htmlpage"
		},
		"vmware.monitoring.location.state": {
			"class": "CControllerVMwareLocationState",
			"layout": "layout.json"
		},
		"vmware.monitoring.list": {
			"class": "CControllerVMwareList",
			"view": "vmware.monitoring.list",
			"layout": "layout.htmlpage"
		},
		"vmware.monitoring.list.data": {
			"class": "CControllerVMwareListData",
			"layout": "layout.json"
		},
		"vmware.monitoring.view": {
			"class": "CControllerVMwareView",
			"view": "vmware.monitoring.view",
			"layout": "layout.htmlpage"
		},
		"vmware.monitoring.tab": {
			"class": "CControllerVMwareTab",
			"layout": "layout.json"
		},
		"vmware.monitoring.sparkline": {
			"class": "CControllerVMwareSparkline",
			"layout": "layout.json"
		},
		"vmware.monitoring.datastore.attachments": {
			"class": "CControllerVMwareDatastoreAttachments",
			"layout": "layout.json"
		},
		"vmware.monitoring.hypervisor": {
			"class": "CControllerVMwareSensors",
			"view": "vmware.monitoring.hypervisor",
			"layout": "layout.htmlpage"
		},
		"vmware.monitoring.cluster": {
			"class": "CControllerVMwareCluster",
			"view": "vmware.monitoring.cluster",
			"layout": "layout.htmlpage"
		}
	},
	"assets": {
		"css": ["common.css", "components.css", "blue-theme.css", "dark-theme.css"],
		"js": ["common.js", "components.js"]
	}
}
